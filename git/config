[alias]
        # いい感じのグラフでログを表示
        # graph = log --graph --date=short --decorate=short --pretty=format:'%Cgreen%h %Creset%cd %Cblue%cn %Cred%d %Creset%s'
        # 上の省略形
        gr = log --graph --date=short --decorate=short --pretty=format:'%Cgreen%h %Creset%cd %Cblue%cn %Cred%d %Creset%s'
        st = status
        cm = commit
        co = checkout
        cob = checkout -b
        sw = switch
        br = branch
        al = config --get-regexp ^alias\\.
        pl = !git pull origin $(git rev-parse --abbrev-ref HEAD)
        psoh = push origin HEAD
        bd = branch -d
        # 現在いるブランチ以外のローカルブランチを削除
        bad = !git branch | xargs git branch -d
        cb = "!f() { git branch --show-current | tr -d '\n' | pbcopy; echo 'Current branch name copied to clipboard.'; }; f"

        # 指定のワーディングで変更が入ったコミットを抽出（日付付き）
        # 使い方: git logs "検索文字列" [件数(デフォルト20)]
        logs = "!f() { git log --all -S\"$1\" --pretty=format:\"%h %ad %s\" --date=short | head -${2:-20}; }; f"

        # 特定のコミットがマージされたPRを表示（PR URLも表示）
        # 使い方: git pr-url <コミットハッシュ>
        pr-url = "!f() { \
                PR=$(git log --all --ancestry-path --reverse $1..HEAD --merges --oneline --pretty=format:\"%s\" | grep -o '#[0-9]\\+' | head -1); \
                if [ -n \"$PR\" ]; then \
                        REMOTE=$(git remote get-url origin | sed 's/\\.git$//' | sed 's/git@github\\.com:/https:\\/\\/github.com\\//'); \
                        echo \"$REMOTE/pull/${PR#\\#}\"; \
                else \
                        echo \"PR not found for commit $1\"; \
                fi; \
        }; f"
[user]
	name = Yuji-Momotani
        signingkey = ~/.ssh/id_ed25519.pub
	email = yuji.momotani256@gmail.com
[core]
	editor = cursor --wait
[gpg]
        format = ssh
[gpg "ssh"]
        # 参考記事（ただし、記事の方はファイル名を間違えているため注意）
        # https://qiita.com/haw_ohnuma/items/51fa84449bc4a1393846
        allowedSignersFile = ~/.ssh/allowed_signers
[commit]
        gpgsign = true
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
